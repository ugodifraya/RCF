{
  "expo": {
    "name": "RCF Team Manager",
    "slug": "rcf-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rcf",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e2a8e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rcf.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e2a8e"
      },
      "package": "com.rcf.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
